# Copy this file to .env before starting Docker Compose. Do not commit .env.
# Change both local-development credentials below before exposing the stack.
MONGO_ROOT_USERNAME=ctiadmin
MONGO_ROOT_PASSWORD=replace-with-generated-password
FLASK_SECRET_KEY=replace-with-generated-flask-secret

# LLM: ollama (default), openai, or demo. If Ollama is unavailable, the app
# automatically responds in labelled offline evidence mode.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embeddings: ollama or openai. Offline deterministic hashing is the fallback.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OPENAI_EMBED_MODEL=text-embedding-3-small

# local = cosine similarity against MongoDB documents. atlas = Atlas Vector Search
# (requires an Atlas vector index named VECTOR_INDEX_NAME on knowledge_chunks.embedding).
VECTOR_SEARCH_MODE=local
VECTOR_INDEX_NAME=cti_vector_index

# Optional CTI provider integrations. Configure only services for which you have permission.
VIRUSTOTAL_API_KEY=
MISP_URL=
MISP_API_KEY=
MISP_VERIFY_SSL=true
MALWAREBAZAAR_API_KEY=
THREATFOX_API_KEY=
URLHAUS_API_KEY=
OTX_API_KEY=
MALPEDIA_API_TOKEN=
CUCKOO_API_URL=
CUCKOO_API_TOKEN=
CTI_DIGEST_URL=https://ctidigest.com/

MAX_UPLOAD_MB=50
EXTERNAL_API_TIMEOUT=12

# Optional custom URL classifier. Leave HF_MODEL_REPO_ID blank until a trained
# artifact is published. Prefer a Hugging Face commit hash for HF_MODEL_REVISION.
CTI_MODEL_PATH=models/url_classifier.joblib
HF_MODEL_REPO_ID=
HF_MODEL_REVISION=main
HF_MODEL_FILENAME=url_classifier.joblib
HF_TOKEN=

# Optional authenticated dataset acquisition for model training. Keep keys in
# local .env only; do not commit them or add them to public training artifacts.
PHISHTANK_APP_KEY=
URLHAUS_AUTH_KEY=
